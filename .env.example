# Copy to .env and edit; the configs resolve their paths against these variables.

# MIMIC-IV v3.1 (hosp/, icu/) and the mimic-code concept tables (concepts/)
MIMIC_RAW=/path/to/mimic-iv-3.1

# pipeline outputs: about 25 GB for the data stage, about 96 GB per embedding cache
CLIN_JEPA_DATA=/path/to/clin_jepa_data

# checkpoints, rollouts, evaluation results, figures and tables
CLIN_JEPA_OUTPUT=/path/to/clin_jepa_output

# Hugging Face cache holding Qwen/Qwen3-8B (16 GB)
HF_HOME=/path/to/huggingface

# CLMBR-T-base (stage 08): model directory and a mimic-code checkout
CLMBR_MODEL=/path/to/clmbr-t-base
MIMIC_CODE=/path/to/mimic-code

# Optional frozen-base experiment and sequential trajectory preparation
QWEN3_BASE=/path/to/Qwen3-8B
CLIN_JEPA_PYTHON=/path/to/python
CLIN_JEPA_CPU_JOBS=2
